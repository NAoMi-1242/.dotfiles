#!/bin/bash

# Windows側のユーザー名をPowerShell経由で動的に取得（CRLFの改行コードを削除）
WIN_USER=$(pwsh.exe -NoProfile -Command "[Environment]::UserName" | tr -d '\r\n')
DOTFILES_DIR="/mnt/c/Users/${WIN_USER}/.dotfiles"

if [ ! -d "$DOTFILES_DIR" ]; then
    echo "❌ ドットファイルディレクトリが見つかりません: $DOTFILES_DIR"
    exit 1
fi

cd "$DOTFILES_DIR" || exit 1
CURRENT_BRANCH=$(git branch --show-current)

echo "🔄 ドットファイルリポジトリを更新（Pull）しています..."
git pull origin "$CURRENT_BRANCH"
